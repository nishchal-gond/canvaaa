{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lph-automation-prod-display-backend.kwmwz0.easypanel.host/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://lph-automation-prod-display-backend.kwmwz0.easypanel.host/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
